NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense. Leave empty until AdSense approves the site; grey placeholders show instead.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Server tuning (optional)
MAX_PARALLEL_CONVERSIONS=2
RATE_LIMIT_PER_10_MIN=30
